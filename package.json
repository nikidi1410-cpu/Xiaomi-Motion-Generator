{
  "name": "xiaomi-motion-generator",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Generator video motion graphic vertikal 9:16 (1080x1920 @60fps, 30 detik) - Xiaomi Human x Car x Home",
  "scripts": {
    "dev": "vite --port 5173",
    "build": "tsc --noEmit && vite build",
